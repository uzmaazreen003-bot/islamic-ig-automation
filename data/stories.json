      },
      {
       "k": "plate",
       "x": 0.45,
       "s": 1.0
      }
     ],
     "hl": [
      "more"
     ],
     "focus": 0.4
    },
    {
     "text": "The old man next door lived alone. His windows were dark by sunset.",
     "cast": [
      {
       "who": "elder",
       "x": 0.7,
       "pose": "stand",
       "face": -1
      }
     ],
     "props": [
      {
       "k": "house",
       "x": 0.28,
       "s": 1.0
      }
     ],
     "hl": [
      "alone"
     ],
     "focus": 0.7
    },
    {
     "text": "So Yusuf carried a warm plate across the lane.",
