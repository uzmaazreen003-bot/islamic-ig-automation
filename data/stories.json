       "s": 1.0
      }
     ],
     "hl": [
      "more"
     ],
     "focus": 0.4
    },
    {
     "text": "Across the road, Mr. Karim ate rice and dal with his grandchildren.",
     "cast": [
      {
       "who": "elder",
       "x": 0.35,
       "pose": "sit"
      },
      {
       "who": "child",
       "x": 0.55,
       "pose": "sit",
       "role": "other"
