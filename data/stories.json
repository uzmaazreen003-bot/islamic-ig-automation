       "x": 0.8,
       "s": 1.0
      },
      {
       "k": "bowl",
       "x": 0.45,
       "s": 1.0
      }
     ],
     "hl": [
      "laughing"
     ],
     "focus": 0.5
    },
    {
     "text": "Idris stood by his gate and watched them laugh.",
     "cast": [
      {
       "who": "man",
       "x": 0.3,
       "pose": "look",
       "face": 1
      }
     ],
     "props": [
      {
       "k": "lamp",
       "x": 0.7,
       "s": 1.0,
       "y": 0.66
      }
     ],
     "hl": [
      "laugh"
     ],
     "focus": 0.5
    },
    {
     "text": "Some people own a lot. Some people have enough. They are not the same.",
     "cast": [
      {
       "who": "man",
       "x": 0.5,
       "pose": "stand"
      }
     ],
     "props": [
      {
       "k": "sun",
       "x": 0.5,
       "s": 1.0,
