       "x": 0.65,
       "s": 1.0
      },
      {
       "k": "house",
       "x": 0.85,
       "s": 1.0
      }
     ],
     "hl": [
      "warm",
      "plate"
     ],
     "focus": 0.5
    },
    {
     "text": "The old man did not say much. His eyes said it all.",
     "cast": [
      {
       "who": "child",
       "x": 0.4,
       "pose": "stand"
      },
      {
       "who": "elder",
       "x": 0.62,
