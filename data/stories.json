       "y": 0.52
      }
     ],
     "hl": [
      "eyes"
     ],
     "focus": 0.5
    },
    {
     "text": "That night, a light was on in his window.",
     "cast": [
      {
       "who": "elder",
       "x": 0.5,
       "pose": "sit"
      }
     ],
     "props": [
      {
       "k": "house",
       "x": 0.5,
       "s": 1.0
